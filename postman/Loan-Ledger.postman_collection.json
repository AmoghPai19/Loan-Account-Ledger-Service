{
  "info": {
    "name": "Loan Account Ledger Service",
    "description": "Walks through the whole service. Start the API (npm start), then Run collection: folders run in order and each request checks its own result. Money is in paise (Rs.9,168.00 = 916800). Run it as many times as you like: each run creates a new borrower and loan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Health check (no key)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I? (officer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('role is OFFICER', () => pm.expect(pm.response.json().role).to.eql('OFFICER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('three products: EMI, FLT, WGL', () => pm.expect(pm.response.json().map(p => p.code)).to.eql(['EMI', 'FLT', 'WGL']));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Loan life cycle",
      "description": "Run in order: each request saves ids for the next.",
      "item": [
        {
          "name": "Create borrower (officer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/borrowers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrowers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalRef\": \"{{externalRef}}\",\n  \"fullName\": \"Priya Sharma\",\n  \"phone\": \"+91-00000-99999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh reference on every run, so the collection can be run again and again.",
                  "pm.collectionVariables.set('externalRef', 'PM-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('borrowerId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create loan: Rs.1,00,000 EMI, 18%, 12 months (officer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrowerId\": \"{{borrowerId}}\",\n  \"productCode\": \"EMI\",\n  \"principalPaise\": 10000000,\n  \"tenure\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const loan = pm.response.json();",
                  "pm.collectionVariables.set('loanId', loan.id);",
                  "pm.test('status CREATED, product terms copied onto the loan', () => {",
                  "  pm.expect(loan.status).to.eql('CREATED');",
                  "  pm.expect(loan.annualRateBps).to.eql(1800);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Disburse as OFFICER: refused (maker-checker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/disburse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "disburse"
              ]
            },
            "description": "Officers create loans; only managers may release money.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disbursedOn\": \"2026-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('error code FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disburse as MANAGER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{managerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/disburse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "disburse"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disbursedOn\": \"2026-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('DISBURSED, 12 instalments, first due 2026-02-15', () => {",
                  "  pm.expect(r.loan.status).to.eql('DISBURSED');",
                  "  pm.expect(r.instalments).to.eql(12);",
                  "  pm.expect(r.loan.firstDueDate).to.eql('2026-02-15');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "View repayment schedule",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/schedule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "schedule"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('EMI Rs.9,168.00: month 1 is Rs.1,500 interest + Rs.7,668 principal', () => {",
                  "  pm.expect(s.instalments[0].interestDuePaise).to.eql(150000);",
                  "  pm.expect(s.instalments[0].principalDuePaise).to.eql(766800);",
                  "});",
                  "pm.test('principal sums exactly to the loan amount', () => pm.expect(s.totals.principalDuePaise).to.eql(10000000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Post first EMI (officer, new Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/repayments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "repayments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 916800,\n  \"effectiveDate\": \"2026-02-15\",\n  \"externalEventId\": \"UPI-DEMO-0001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One key per intended payment. The next request reuses it, like a client retry.",
                  "pm.collectionVariables.set('paymentKey', 'PAY-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('transactionId', r.transactionId);",
                  "pm.test('posted (not a replay)', () => pm.expect(r.replayed).to.eql(false));",
                  "pm.test('Rs.1,500 interest first, then Rs.7,668 principal', () =>",
                  "  pm.expect(r.allocation.map(a => [a.component, a.amountPaise])).to.eql([['INTEREST', 150000], ['PRINCIPAL', 766800]]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry the same payment: replayed, not posted twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/repayments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "repayments"
              ]
            },
            "description": "Same key, same body: the stored response comes back and nothing new is posted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 916800,\n  \"effectiveDate\": \"2026-02-15\",\n  \"externalEventId\": \"UPI-DEMO-0001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 (the original status)', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Idempotent-Replayed: true', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('same transaction as the first request', () => pm.expect(r.transactionId).to.eql(pm.collectionVariables.get('transactionId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different amount: rejected (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/repayments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "repayments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 100,\n  \"effectiveDate\": \"2026-02-15\",\n  \"externalEventId\": \"UPI-DEMO-0001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('error code IDEMPOTENCY_KEY_REUSED', () => pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REUSED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repayment without an Idempotency-Key: rejected (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/repayments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "repayments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 100,\n  \"effectiveDate\": \"2026-02-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "View loan: balances derived from the ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{officerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('principal owed fell once, by Rs.7,668 (not twice)', () =>",
                  "  pm.expect(pm.response.json().balances.principalReceivablePaise).to.eql(10000000 - 766800));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
