              ],
              "path": [
                "ledger",
                "trial-balance"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const tb = pm.response.json();",
                  "pm.test('balanced', () => { pm.expect(tb.balanced).to.eql(true); pm.expect(tb.debitsPaise).to.eql(tb.creditsPaise); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Audit trail of this loan (auditor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{auditorKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/audit?entityType=loan&entityId={{loanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit"
              ],
              "query": [
                {
                  "key": "entityType",
                  "value": "loan"
                },
                {
                  "key": "entityId",
                  "value": "{{loanId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().slice().reverse(); // oldest first",
                  "pm.test('created by officer, disbursed by manager, repaid by officer', () =>",
                  "  pm.expect(rows.map(r => [r.action, r.actorUsername])).to.eql([",
                  "    ['LOAN_CREATED', 'officer.asha'], ['LOAN_DISBURSED', 'manager.ravi'], ['REPAYMENT_POSTED', 'officer.asha']]));",
                  "pm.test('the refused disbursement and the replay left no audit rows', () => pm.expect(rows.length).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Auditor tries to create a borrower: refused",
          "request": {
            "method": "POST",
            "header": [
              {
